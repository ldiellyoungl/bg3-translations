                                                    </ls:LSButton>

                                                    <ls:LSButton x:Name="rotateLeftBtn" Template="{StaticResource RotateLeftButton}">
                                                        <b:Interaction.Triggers>
                                                            <b:EventTrigger EventName="LSButtonPressed">
                                                                <b:ChangePropertyAction
                                                                    PropertyName="RotationSpeed"
                                                                    TargetName="PlayerPaperdoll"
                                                                    Value="{StaticResource PaperdollRotateCounterClockwiseSpeed}" />
                                                            </b:EventTrigger>
