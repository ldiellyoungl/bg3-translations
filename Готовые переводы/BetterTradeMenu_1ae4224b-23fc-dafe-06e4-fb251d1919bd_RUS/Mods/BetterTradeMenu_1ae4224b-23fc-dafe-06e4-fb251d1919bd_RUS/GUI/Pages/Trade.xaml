                                                    <BitmapImage x:Key="ToggleBGHover" UriSource="pack://application:,,,/Core;component/Assets/Trade/trade_toggle_h.png" />
                                                    <BitmapImage x:Key="ToggleBGPress" UriSource="pack://application:,,,/Core;component/Assets/Trade/trade_toggle_p.png" />
                                                    <BitmapImage x:Key="ToggleNob" UriSource="pack://application:,,,/Core;component/Assets/Trade/trade_toggle_notch_d.png" />
                                                    <BitmapImage x:Key="ToggleNobHover" UriSource="pack://application:,,,/Core;component/Assets/Trade/trade_toggle_notch_h.png" />
                                                </ControlTemplate.Resources>
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
