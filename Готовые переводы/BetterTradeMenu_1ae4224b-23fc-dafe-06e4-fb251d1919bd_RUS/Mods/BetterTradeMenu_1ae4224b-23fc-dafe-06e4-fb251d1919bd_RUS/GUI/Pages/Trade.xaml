                                            <Path
                                                Margin="4,20,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource HeaderBackgroundStyle}" />

                                            <Grid
                                                Width="730"
                                                Height="1340"
                                                Margin="0,-50,0,12"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                ClipToBounds="True"
                                                DataContext="{Binding Trader}">
                                                <ls:LSPaperdoll
                                                    x:Name="CSPaperdoll"
                                                    Width="{StaticResource CSDollWidth}"
                                                    Height="{StaticResource CSDollHeight}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    EntityRef="{Binding EntityHandle}"
                                                    ClipToBounds="True"
                                                    UseCombatPose="True"
                                                    MouseRotate="True"
                                                    MouseRotateMultiplier="10"
                                                    RenderScale="{Binding DataContext.Data.RenderScale, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" />
                                                <!--  DOLL CONTROLS  -->
                                                <StackPanel
                                                    Margin="0,0,0,140"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Orientation="Horizontal">
                                                    <ls:LSButton x:Name="rotateTraderRightBtn" Template="{StaticResource RotateRightButton}">
                                                        <b:Interaction.Triggers>
                                                            <b:EventTrigger EventName="LSButtonPressed">
                                                                <b:ChangePropertyAction
                                                                    PropertyName="RotationSpeed"
                                                                    TargetName="CSPaperdoll"
                                                                    Value="{StaticResource PaperdollRotateClockwiseSpeed}" />
                                                            </b:EventTrigger>
                                                            <b:EventTrigger EventName="LSButtonReleased">
