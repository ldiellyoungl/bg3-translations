                                                        <b:Interaction.Behaviors>
                                                            <b:ConditionBehavior>
                                                                <b:ConditionalExpression>
                                                                    <b:ComparisonCondition
                                                                        LeftOperand="{Binding Path=IsMouseOver, ElementName=TraderInventory}"
                                                                        Operator="Equal"
                                                                        RightOperand="False" />
                                                                </b:ConditionalExpression>
                                                            </b:ConditionBehavior>
                                                        </b:Interaction.Behaviors>
                                                        <b:ChangePropertyAction
                                                            PropertyName="SelectedIndex"
                                                            TargetName="TraderInventory"
                                                            Value="-1" />
                                                    </b:EventTrigger>

                                                    <b:EventTrigger EventName="SelectionChanged">
                                                        <b:InvokeCommandAction Command="{Binding UpdateSelectionCommand}" CommandParameter="{Binding SelectedItems, ElementName=TraderInventory}" />
                                                    </b:EventTrigger>

                                                    <b:PropertyChangedTrigger Binding="{Binding Path=Mode}">
                                                        <b:ChangePropertyAction
                                                            PropertyName="SelectedIndex"
                                                            TargetName="TraderInventory"
                                                            Value="-1" />
                                                    </b:PropertyChangedTrigger>
                                                </b:Interaction.Triggers>
                                            </ListBox>

                                            <!--  Bottom buttons  -->
                                            <Grid
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Sort options  -->
                                                <ls:LSComboBox
                                                    x:Name="sortComboBox"
                                                    Grid.Column="0"
                                                    Width="400"
                                                    Margin="0,48,0,0"
                                                    VerticalAlignment="Top"
                                                    noesis:Text.Placeholder="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                                                    SoundID="UI_HUD_Inventory_Sort"
                                                    ItemsSource="{Binding Path=CurrentPlayer.UIData.InventorySortOptions}"
                                                    SelectedItem="{Binding TradeSortOption}"
                                                    Style="{StaticResource SortListLabelStyle}" />

                                                <!--  Balance and Trade Buttons  -->
                                                <Grid
                                                    x:Name="BalanceButtonHolder"
                                                    Grid.Column="1"
                                                    Margin="12,0,0,-300"
                                                    HorizontalAlignment="Center">
                                                    <Image Source="{StaticResource BackgroundDoubleButtonImage}" Stretch="None" />

                                                    <StackPanel
                                                        Margin="0,64,16,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Orientation="Vertical">
                                                        <ls:LSButton
                                                            x:Name="BalanceBtn"
                                                            MinWidth="480"
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource BigBrownButtonTextAndIconStyle}"
                                                            Command="{Binding BalanceTrade}"
                                                            Content="{Binding Source='hb0e3f01fg505eg43ffg87e0g088ea4853d46', Converter={StaticResource TranslatedStringConverter}}"
                                                            SoundID="UI_HUD_Barter"
                                                            IsEnabled="{Binding TradeButtonsEnabled}">
                                                            <ls:LSButton.Resources>
                                                                <ImageBrush
                                                                    x:Key="IconNormal"
                                                                    ImageSource="pack://application:,,,/Core;component/Assets/Trade/ico_balance_d.png"
                                                                    Stretch="Fill" />
                                                                <ImageBrush
                                                                    x:Key="IconPressed"
                                                                    ImageSource="pack://application:,,,/Core;component/Assets/Trade/ico_balance_h.png"
                                                                    Stretch="Fill" />
                                                                <ImageBrush
                                                                    x:Key="IconHighlight"
                                                                    ImageSource="pack://application:,,,/Core;component/Assets/Trade/ico_balance_h.png"
                                                                    Stretch="Fill" />
                                                                <ImageBrush
                                                                    x:Key="IconDisabled"
                                                                    ImageSource="pack://application:,,,/Core;component/Assets/Trade/ico_balance_d.png"
                                                                    Stretch="Fill" />
                                                            </ls:LSButton.Resources>
                                                        </ls:LSButton>

                                                        <ls:LSButton
                                                            x:Name="BarterBtn"
                                                            MinWidth="480"
                                                            Margin="0,32,0,0"
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource BigBlueButtonStyle}"
                                                            Content="{Binding Source='hdfe9a22fg1d5ag4132g9d91g716029f5d66f', Converter={StaticResource TranslatedStringConverter}}"
                                                            Command="{Binding FinishBarter}"
                                                            CommandParameter="{Binding ActionCommandParameter}"
                                                            SoundID="UI_HUD_Barter"
                                                            IsEnabled="{Binding TradeButtonsEnabled}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid
                                                    x:Name="TradeButtonHolder"
                                                    Grid.Column="1"
                                                    Margin="-4,0,0,-304"
                                                    HorizontalAlignment="Center"
                                                    Visibility="Collapsed">
                                                    <Image
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="{StaticResource BackgroundSingleButtonImage}"
                                                        Stretch="None" />
                                                    <ls:LSButton
                                                        x:Name="TradeButton"
                                                        MinWidth="480"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BigBlueButtonStyle}"
                                                        Command="{Binding FinishTrade}"
                                                        Content="{Binding Source='h4d74c17cg64c1g4bbdgb6dag29a88b29bed2', Converter={StaticResource TranslatedStringConverter}}"
                                                        SoundID="UI_HUD_Barter"
                                                        IsEnabled="{Binding TradeButtonsEnabled}">
                                                        <b:Interaction.Triggers>
                                                            <!--  When the ListBoxes lose their focus, they reset their selection, but we don't want to do that while hovering TradeButton since we are about to trade  -->
                                                            <b:PropertyChangedTrigger Binding="{Binding IsMouseOver, ElementName=TradeButton}">
                                                                <b:ChangePropertyAction
                                                                    TargetObject="{Binding .}"
                                                                    PropertyName="CanUpdateSelection"
                                                                    Value="{Binding IsMouseOver, ElementName=TradeButton, Converter={StaticResource InvertBoolConverter}}" />
