                                                        Foreground="{StaticResource LS_extraspecialTxtColor}" />
                                                    <Grid Grid.Column="1" Margin="-20,0">
                                                        <Image
                                                            x:Name="bg"
                                                            Source="{StaticResource ToggleBG}"
                                                            Stretch="None" />
                                                        <Image
                                                            x:Name="btn"
                                                            Margin="32,0"
                                                            HorizontalAlignment="Left"
                                                            Source="{StaticResource ToggleNob}"
                                                            Stretch="None" />
                                                    </Grid>
                                                    <TextBlock
                                                        x:Name="BarterTxt"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Source='hd4ebf395gca4fg40e5gbc16gf9b31778850a', Converter={StaticResource TranslatedStringConverter}}"
                                                        Foreground="{StaticResource LS_accent75TxtColor}" />
