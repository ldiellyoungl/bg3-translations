                                                    <ItemsPanelTemplate>
                                                        <ls:LSGrid
                                                            x:Name="InvGridTrader"
                                                            Style="{StaticResource InventoryGridStyle}"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                                            <b:Interaction.Behaviors>
                                                                <ls:DragGameObjectGridBehavior StartDragCommand="{Binding DragTradeSlotCommand}" DragCommandParameter="{Binding SelectedItems, ElementName=PlayerBarterOffer}" />
                                                                <ls:DropOnInventoryGridBehavior DropCommand="{Binding DropPlayerOfferInventoryTradeSlotCommand}" />
                                                            </b:Interaction.Behaviors>
                                                        </ls:LSGrid>
                                                    </ItemsPanelTemplate>
