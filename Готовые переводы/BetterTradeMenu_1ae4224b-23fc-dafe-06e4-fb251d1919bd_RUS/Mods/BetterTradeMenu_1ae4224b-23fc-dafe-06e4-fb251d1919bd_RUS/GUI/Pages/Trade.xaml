                                                        <b:Interaction.Behaviors>
                                                            <b:ConditionBehavior>
                                                                <b:ConditionalExpression>
                                                                    <b:ComparisonCondition
                                                                        LeftOperand="{Binding Path=IsMouseOver, ElementName=PlayerBarterOffer}"
                                                                        Operator="Equal"
                                                                        RightOperand="False" />
                                                                </b:ConditionalExpression>
                                                            </b:ConditionBehavior>
                                                        </b:Interaction.Behaviors>
                                                        <b:ChangePropertyAction
                                                            PropertyName="SelectedIndex"
                                                            TargetName="PlayerBarterOffer"
                                                            Value="-1" />
                                                    </b:EventTrigger>
                                                </b:Interaction.Triggers>
                                            </ListBox>

                                            <!--  Trader offer  -->
                                            <TextBlock
                                                x:Name="TraderOfferText"
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Text="{Binding Source='h5bc87a4ag3e01g4572gac64g4db7257911b2', Converter={StaticResource TranslatedStringConverter}}"
                                                Style="{StaticResource BarterHeaderTextStyle}"
                                                TextWrapping="Wrap"
                                                TextAlignment="Center" />

                                            <ContentControl
                                                x:Name="TraderOfferGold"
                                                Grid.Row="2"
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                DataContext="{Binding TraderOfferGold}"
                                                Template="{StaticResource GoldDisplay}" />

                                            <ListBox
                                                x:Name="TraderBarterOffer"
                                                Grid.Row="3"
                                                Grid.Column="3"
                                                Padding="0,0,-16,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource BarterGridStyle}"
                                                Template="{StaticResource TraderGridTemplate}"
                                                ItemsSource="{Binding TraderOffer.Slots}">
                                                <ListBox.Resources>
                                                    <System:UInt32 x:Key="invRows">14</System:UInt32>
                                                    <System:UInt32 x:Key="invCols">2</System:UInt32>
                                                </ListBox.Resources>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ls:LSGrid
                                                            x:Name="TraderBarterGrid"
                                                            Style="{StaticResource InventoryGridStyle}"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                                            <b:Interaction.Behaviors>
                                                                <ls:DragGameObjectGridBehavior StartDragCommand="{Binding DragTradeSlotCommand}" DragCommandParameter="{Binding SelectedItems, ElementName=TraderBarterOffer}" />
                                                                <ls:DropOnInventoryGridBehavior DropCommand="{Binding DropTraderOfferInventoryTradeSlotCommand}" />
                                                            </b:Interaction.Behaviors>
                                                        </ls:LSGrid>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>

                                                <b:Interaction.Triggers>
                                                    <b:DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TraderBarterOffer}" Value="False">
                                                        <b:ChangePropertyAction
                                                            PropertyName="SelectedIndex"
                                                            TargetName="TraderBarterOffer"
                                                            Value="-1" />
                                                    </b:DataTrigger>
                                                    <b:EventTrigger EventName="MouseRightButtonUp" SourceObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}">
                                                        <b:Interaction.Behaviors>
                                                            <b:ConditionBehavior>
                                                                <b:ConditionalExpression>
                                                                    <b:ComparisonCondition
                                                                        LeftOperand="{Binding Path=IsMouseOver, ElementName=TraderBarterOffer}"
                                                                        Operator="Equal"
                                                                        RightOperand="False" />
                                                                </b:ConditionalExpression>
                                                            </b:ConditionBehavior>
                                                        </b:Interaction.Behaviors>
                                                        <b:ChangePropertyAction
                                                            PropertyName="SelectedIndex"
                                                            TargetName="TraderBarterOffer"
                                                            Value="-1" />
                                                    </b:EventTrigger>
                                                </b:Interaction.Triggers>
                                            </ListBox>

                                            <!--  Trader Gold  -->
                                            <ContentControl
                                                x:Name="TraderGold"
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Margin="0,14,56,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                DataContext="{Binding TraderInventoryGold, StringFormat={}{0:N0}}"
                                                Template="{StaticResource GoldDisplay}" />

                                            <!--  Trader Selection Gold  -->
                                            <ContentControl
                                                x:Name="TraderSelectionGold"
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="20,14,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                DataContext="{Binding SelectionValue, StringFormat={}{0:N0}}"
                                                Template="{StaticResource SelectionGoldDisplay}"
                                                Visibility="Collapsed" />

                                            <!--  Trader filters  -->
                                            <!--
                                                For now the Trader filters are hidden for Barter, as Buy Back doesn't work properly,
                                                and it would leave only one tab visible, making it pointless to display.
                                            -->
                                            <ls:LSNineSliceImage
                                                x:Name="TraderFilterTabsLine"
                                                Grid.Row="1"
                                                Grid.Column="4"
                                                Height="4"
                                                Margin="0,0,20,0"
                                                VerticalAlignment="Bottom"
                                                Slices="20,1"
                                                ImageSource="{StaticResource FilterTabsSeparatorBottom}"
                                                Visibility="Hidden" />

                                            <ListBox
                                                x:Name="TraderFilterTabs"
                                                Grid.Row="1"
                                                Grid.Column="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Visibility="Hidden"
                                                SelectedIndex="0"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource InventoryViewTabStyle}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Path=Tag, RelativeSource={RelativeSource Mode=Self}}" Value="BuyBack" />
