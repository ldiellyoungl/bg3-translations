                                        <Rectangle Grid.Column="1" Grid.Row="1" OpacityMask="{StaticResource PaG.Mask.CrossThin}" Fill="{Binding Fill, ElementName=PaGBadgeCrossThin}" Opacity="{Binding Opacity, ElementName=PaGBadgeCrossThin}"/>
                                        <Rectangle Grid.Column="1" Grid.Row="1" OpacityMask="{StaticResource PaG.Mask.Skull}" Fill="{Binding Fill, ElementName=PaGBadgeSkull}" Opacity="{Binding Opacity, ElementName=PaGBadgeSkull}"/>
                                        <Rectangle Grid.Column="1" Grid.Row="1" OpacityMask="{StaticResource PaG.Mask.Shield}" Fill="{Binding Fill, ElementName=PaGBadgeShield}" Opacity="{Binding Opacity, ElementName=PaGBadgeShield}"/>
