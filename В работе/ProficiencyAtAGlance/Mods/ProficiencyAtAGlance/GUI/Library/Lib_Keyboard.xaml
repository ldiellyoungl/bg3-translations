                                </Grid>
                                <TextBlock Style="{StaticResource TooltipTitleStyle}" Margin="0" VerticalAlignment="Center" Text="{Binding Text, ElementName=PaGWhyTitle}"/>
                            </DockPanel>
                            <!-- one bulleted row per cause; a row with no text is collapsed -->
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy1, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy1}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy2, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy2}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy3, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy3}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy4, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy4}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy5, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy5}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy6, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy6}"/>
                            </Grid>
                            <Grid Visibility="{Binding Text, ElementName=PaGWhy7, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='EmptyString'}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Stretch="None" Source="/Core;component/Assets/CharacterPanel/ico_bullet_d.png" VerticalAlignment="Top" Margin="4,10,16,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource TooltipBaseTextStyle}" Text="{Binding Text, ElementName=PaGWhy7}"/>
                            </Grid>
                        </StackPanel>
                    </ls:LSTooltip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>

                <!-- over the badge: PaGBadge's grid; the target's disc fills its corner cell -->
                <Grid x:Name="PaGHitBadge" Grid.Column="1" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" MinWidth="22"/>
                        <ColumnDefinition Width="65*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35*" MinHeight="22"/>
                        <RowDefinition Height="65*"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Fill">
                        <ls:LSEntityObject x:Name="PaGBadgeHit" Width="100" Height="100" DataContext="{Binding Object}" EntityRef="{Binding EntityHandle}" Context="{Binding Context, RelativeSource={RelativeSource AncestorType={x:Type ls:LSEntityObject}}}" ls:ContextMenuService.GenerateEnabled="False" Background="Transparent" IsHitTestVisible="False">
                            <ls:LSEntityObject.Clip>
                                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                            </ls:LSEntityObject.Clip>
                        </ls:LSEntityObject>
                    </Viewbox>
                </Grid>

                <!-- over the dot: PaGDot's grid -->
                <Grid x:Name="PaGHitDot" Grid.Column="1" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75*"/>
                        <ColumnDefinition Width="25*" MinWidth="12"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75*"/>
                        <RowDefinition Height="25*" MinHeight="12"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Column="1" Grid.Row="1" Stretch="Fill">
                        <ls:LSEntityObject x:Name="PaGDotHit" Width="100" Height="100" DataContext="{Binding Object}" EntityRef="{Binding EntityHandle}" Context="{Binding Context, RelativeSource={RelativeSource AncestorType={x:Type ls:LSEntityObject}}}" ls:ContextMenuService.GenerateEnabled="False" Background="Transparent" IsHitTestVisible="False">
                            <ls:LSEntityObject.Clip>
                                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                            </ls:LSEntityObject.Clip>
                        </ls:LSEntityObject>
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Object.Type}" Value="Item">
                <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource Template.Item}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Object.IsEquipment}" Value="True">
                <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource Template.ItemEquipment}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Object.Type}" Value="Item"/>
                    <Condition Binding="{Binding Object.IsContainer}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource Template.ItemContainer}"/>
            </MultiDataTrigger>
            <!-- PaG gray: while Lua shows PaGGray, the art loses most of its color, rarity frame included -->
            <Trigger SourceName="PaGGray" Property="Opacity" Value="1">
                <Setter TargetName="Presenter" Property="Effect">
                    <Setter.Value>
                        <ls:SaturationEffect Saturation="0.1"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <!-- PaG (mark tooltips): each hover target takes the mouse only while its mark shows -->
            <Trigger SourceName="PaGBadge" Property="Opacity" Value="1">
                <Setter TargetName="PaGBadgeHit" Property="IsHitTestVisible" Value="True"/>
            </Trigger>
            <Trigger SourceName="PaGDot" Property="Opacity" Value="1">
                <Setter TargetName="PaGDotHit" Property="IsHitTestVisible" Value="True"/>
            </Trigger>
            <!-- PaG (mark tooltips): no text, no tooltip (a Good item, tooltips off, or the text could not
                 be worded). These come after the marks' triggers, so they win; null as well as empty,
                 as the game's own filter boxes test -->
            <Trigger SourceName="PaGWhy" Property="Text" Value="">
                <Setter TargetName="PaGBadgeHit" Property="IsHitTestVisible" Value="False"/>
                <Setter TargetName="PaGDotHit" Property="IsHitTestVisible" Value="False"/>
            </Trigger>
            <Trigger SourceName="PaGWhy" Property="Text" Value="{x:Null}">
                <Setter TargetName="PaGBadgeHit" Property="IsHitTestVisible" Value="False"/>
                <Setter TargetName="PaGDotHit" Property="IsHitTestVisible" Value="False"/>
            </Trigger>
            <!-- PaG corners: while Lua shows PaGSwap, the badge and the dot turn half a turn about the
                 cell's center, so the badge sits bottom-right and the dot top-left. The disc turns back
                 about its own center, so the icon stays upright. Their hover targets turn with them.
                 Render-only: no layout changes -->
            <Trigger SourceName="PaGSwap" Property="Opacity" Value="1">
                <Setter TargetName="PaGBadge" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PaGBadgeDisc" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PaGDot" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PaGHitBadge" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PaGHitDot" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- PaG (mark tooltips): the game's item styles wrap each cell's content in a ContentPresenter
         with IsHitTestVisible="False", so nothing in Template.InventorySlot could take the mouse. The
         styles below are the game's, copied as they are but for the one change each names, mostly that
         attribute removed (the cell's own Presenter and PaGParts still take no mouse input; only
         PaGHit's targets can). They sit above their users: a StaticResource must be declared above its
         first use. One list is not reached: the alchemy pop-out's ingredient grid
         (CharacterSheetTemplates_k.xaml:5106-5158) keeps its wall. Its item style is inline in
         PopOutAlchemyTemplate (:5068), a local resource of AlchemyPanelTemplate (:4503-6002), so
         only a 1500-line copy of that template could reach it; marks there get no tooltip -->

    <!-- PaG: Trade.xaml:276-305, the template of the page's ListItemStyle (its Template setter, :274);
         one change: its ContentPresenter (:292) no longer sets IsHitTestVisible="False" -->
    <ControlTemplate x:Key="PaG.TradeItemTemplate" TargetType="ListBoxItem">
        <ls:LSEntityObject x:Name="CellRoot" Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" ls:ContextMenuService.GenerateEnabled="False" DataContext="{Binding Object}" EntityRef="{Binding EntityHandle}" Background="Transparent" ToolTipService.Placement="Right">
            <ls:LSEntityObject.ToolTip>
                <ls:LSTooltip Content="{Binding DataContext.Object,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
            </ls:LSEntityObject.ToolTip>

            <ls:AttachedProperties.AutomationId>
                <MultiBinding StringFormat="{}InventoryItem_{0}">
                    <Binding Path="EntityUUID"/>
                </MultiBinding>
            </ls:AttachedProperties.AutomationId>

            <b:Interaction.Behaviors>
                <ls:ContextMenuFillBehavior Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" Player="{Binding DataContext.CurrentPlayer, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" TargetObject="{Binding .}" Source="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=ListBox}}" FillCommand="{Binding DataContext.ContextActionMenuFill, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
            </b:Interaction.Behaviors>

            <ContentPresenter ls:ElementCacheHelper.GroupId="{TemplateBinding ls:ElementCacheHelper.GroupId}"/>
            <Image x:Name="SelectedImg" Source="{StaticResource InvSlot_Selector}" IsHitTestVisible="False" Visibility="Hidden" Opacity="1.0" />
        </ls:LSEntityObject>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
                <Setter TargetName="SelectedImg" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
                <Setter TargetName="SelectedImg" Property="Opacity" Value="1.0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- PaG: DataTemplates.xaml:521-586 verbatim (it keeps its own IsHitTestVisible="False", :566); one
         change: a style trigger gives a cell whose context is Trade PaG.TradeItemTemplate. Trade.xaml's
         page-local ListItemStyle (:271, BasedOn this key, context Trade) sets its own Template, which a
         style trigger outranks, so the barter and trader grids (Trade.xaml:717, 781, 891) get it.
         Context Trade also reaches InvContainerListBoxItemStyle (a bag opened from trade); that
         style undoes this trigger with its own, below -->
    <Style x:Key="BaseInvContainerItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="noesis:StyleInteraction.Behaviors">
            <Setter.Value>
                <noesis:StyleBehaviorCollection>
                    <ls:MouseModifyBehavior SuppressMouseEvents="{Binding Path=(ls:MultiSelect.IsEnabled) ,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                </noesis:StyleBehaviorCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="noesis:StyleInteraction.Triggers">
	        <Setter.Value>
		        <noesis:StyleTriggerCollection>
			        <b:EventTrigger EventName="MouseEnter">
				        <ls:LSPlaySound Sound="UI_Shared_Hover"/>
			        </b:EventTrigger>

			        <b:EventTrigger EventName="MouseDoubleClick" >
				        <b:InvokeCommandAction Command="{Binding DataContext.UseGameObject, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Object}" />
			        </b:EventTrigger>
		        </noesis:StyleTriggerCollection>
	        </Setter.Value>
        </Setter>
        <Setter Property="ls:ContextMenuService.Context" Value="Inventory"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ls:LSEntityObject x:Name="CellRoot" Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" ls:ContextMenuService.GenerateEnabled="False" DataContext="{Binding Object}" EntityRef="{Binding EntityHandle}" Background="Transparent" ToolTipService.Placement="Right">
                        <ls:LSEntityObject.ToolTip>
                            <ls:LSTooltip Content="{Binding DataContext.Object,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                        </ls:LSEntityObject.ToolTip>
	                    <b:Interaction.Behaviors>
                            <ls:ContextMenuFillBehavior Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" Player="{Binding DataContext.CurrentPlayer, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" TargetObject="{Binding .}" Source="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=ListBox}}" FillCommand="{Binding DataContext.ContextActionMenuFill, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
	                    </b:Interaction.Behaviors>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseEnter">
                                <ls:LSPlaySound Sound="UI_Shared_Hover"/>
                            </b:EventTrigger>
                            <b:EventTrigger EventName="DragEnter">
                                <b:InvokeCommandAction Command="{Binding DataContext.UpdateDragErrorCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Path=DataContext.Object, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            </b:EventTrigger>
                            <b:EventTrigger EventName="DragLeave">
                                <b:InvokeCommandAction Command="{Binding DataContext.UpdateDragErrorCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ContentPresenter  IsHitTestVisible="False"/>
                        <Image x:Name="SelectedImg" Source="{StaticResource InvSlot_Selector}" IsHitTestVisible="False" Visibility="Hidden" Opacity="1.0" />
                        <Rectangle x:Name="LockForeground" Fill="{StaticResource LS_DisabledPanelColor}" Visibility="Collapsed"/>
                    </ls:LSEntityObject>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectedImg" Property="Opacity" Value="0.8"/>
                        </Trigger>
	                    <Trigger Property="IsMouseOver" Value="True">
		                    <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
		                    <Setter TargetName="SelectedImg" Property="Opacity" Value="1.0"/>
	                    </Trigger>
                        <DataTrigger Binding="{Binding Object.IsGroupingBlocked}" Value="True">
                            <Setter TargetName="LockForeground" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ls:ContextMenuService.Context" Value="Trade">
                <Setter Property="Template" Value="{StaticResource PaG.TradeItemTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- PaG: Trade.xaml:271-353 (the page's ListItemStyle, for the party side of trade); one change: its
         Template is PaG.TradeItemTemplate. PartyCharacterInventoryTemplate below uses it -->
    <Style x:Key="PaG.TradeItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource BaseInvContainerItemStyle}">
        <Setter Property="ls:ContextMenuService.Context" Value="Trade"/>
        <Setter Property="ls:ElementCacheHelper.GroupId" Value="{Binding (ls:ElementCacheHelper.GroupId), RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter Property="Template" Value="{StaticResource PaG.TradeItemTemplate}"/>
        <Setter Property="noesis:StyleInteraction.Triggers">
            <Setter.Value>
                <noesis:StyleTriggerCollection>
                    <b:EventTrigger EventName="MouseEnter">
                        <b:InvokeCommandAction IsEnabled="{Binding Object.IsNew}" Command="{Binding DataContext.ClearItemNewFlag, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Object}"/>
                        <ls:LSPlaySound Sound="UI_Shared_Hover"/>
                    </b:EventTrigger>

                    <b:EventTrigger EventName="MouseDoubleClick">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding Object.Inventories.Count}" Operator="Equal" RightOperand="0"/>
                                    <b:ComparisonCondition LeftOperand="{Binding DataContext.Mode, ElementName=Trade}" Operator="Equal" RightOperand="Trade"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:InvokeCommandAction Command="{Binding DataContext.TradeItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Object}" />
                    </b:EventTrigger>

                    <b:EventTrigger EventName="MouseDoubleClick">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding Object.Inventories.Count}" Operator="Equal" RightOperand="0"/>
                                    <b:ComparisonCondition LeftOperand="{Binding DataContext.Mode, ElementName=Trade}" Operator="Equal" RightOperand="Barter"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:InvokeCommandAction Command="{Binding DataContext.MoveTradeItem, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Object}" />
                    </b:EventTrigger>

                    <b:EventTrigger EventName="MouseDoubleClick">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding Object.Inventories.Count}" Operator="NotEqual" RightOperand="0"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:InvokeCommandAction Command="{Binding DataContext.UseGameObject, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Object}" />
                    </b:EventTrigger>
                </noesis:StyleTriggerCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PaG: DataTemplates.xaml:547-583, BaseInvContainerItemStyle's Template (its setter, :545), which
         InvContainerListBoxItemStyle inherits, keyed so the style below can name it twice; one change:
         its ContentPresenter (:566) no longer sets IsHitTestVisible="False" -->
    <ControlTemplate x:Key="PaG.InvContainerItemTemplate" TargetType="ListBoxItem">
        <ls:LSEntityObject x:Name="CellRoot" Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" ls:ContextMenuService.GenerateEnabled="False" DataContext="{Binding Object}" EntityRef="{Binding EntityHandle}" Background="Transparent" ToolTipService.Placement="Right">
            <ls:LSEntityObject.ToolTip>
                <ls:LSTooltip Content="{Binding DataContext.Object,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
            </ls:LSEntityObject.ToolTip>
	        <b:Interaction.Behaviors>
                <ls:ContextMenuFillBehavior Context="{Binding (ls:ContextMenuService.Context) , RelativeSource={RelativeSource Mode=TemplatedParent} }" Player="{Binding DataContext.CurrentPlayer, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" TargetObject="{Binding .}" Source="{Binding SelectedItems,RelativeSource={RelativeSource AncestorType=ListBox}}" FillCommand="{Binding DataContext.ContextActionMenuFill, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
	        </b:Interaction.Behaviors>
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
                    <ls:LSPlaySound Sound="UI_Shared_Hover"/>
                </b:EventTrigger>
                <b:EventTrigger EventName="DragEnter">
                    <b:InvokeCommandAction Command="{Binding DataContext.UpdateDragErrorCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding Path=DataContext.Object, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                </b:EventTrigger>
                <b:EventTrigger EventName="DragLeave">
                    <b:InvokeCommandAction Command="{Binding DataContext.UpdateDragErrorCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ContentPresenter/>
            <Image x:Name="SelectedImg" Source="{StaticResource InvSlot_Selector}" IsHitTestVisible="False" Visibility="Hidden" Opacity="1.0" />
            <Rectangle x:Name="LockForeground" Fill="{StaticResource LS_DisabledPanelColor}" Visibility="Collapsed"/>
        </ls:LSEntityObject>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
                <Setter TargetName="SelectedImg" Property="Opacity" Value="0.8"/>
            </Trigger>
	        <Trigger Property="IsMouseOver" Value="True">
		        <Setter TargetName="SelectedImg" Property="Visibility" Value="Visible" />
		        <Setter TargetName="SelectedImg" Property="Opacity" Value="1.0"/>
	        </Trigger>
            <DataTrigger Binding="{Binding Object.IsGroupingBlocked}" Value="True">
                <Setter TargetName="LockForeground" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- PaG: DataTemplates.xaml:588-630 (a shared key: Container.xaml:426 and Better Containers use it);
         two changes: its Template (inherited, DT:545-585) is PaG.InvContainerItemTemplate, and a style
         trigger sets that Template again when its context is Trade. A bag opened from trade binds
         ContainerContext Trade (Container.xaml:143, 526), which would fire BaseInvContainerItemStyle's
         Context=Trade trigger; a derived style's triggers follow its base's in the merged list, so
         this one wins and these cells keep their own template -->
    <Style x:Key="InvContainerListBoxItemStyle" TargetType="ListBoxItem"  BasedOn="{StaticResource BaseInvContainerItemStyle}">
        <Setter Property="ls:ContextMenuService.Context" Value="{Binding DataContext.ContainerContext,RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
        <Setter Property="noesis:StyleInteraction.Triggers">
	        <Setter.Value>
                <noesis:StyleTriggerCollection>
