        {
          "SectionId": "core",
          "SectionName": "Marks",
          "Handles": {
            "NameHandle": "hf1b47448g3791g55abg895eg7c443a80f68e"
          },
          "Settings": [
            {
              "Id": "enabled",
              "Name": "Show proficiency marks",
              "Description": "Marks weapons and armor as Bad, Not Ideal or Good for one character. Off removes every mark.",
              "Tooltip": "Items in inventory, container and trade slots are rated for one character, a<br>companion's items and a trader's stock included. While trading, that is the party member chosen in the trade window. Otherwise it is your selected character. Equipped items are rated for their wearer. For a Pact of the Blade or Hexblade warlock, a melee weapon they aren't<br>proficient with is Not Ideal rather than Bad, since binding it makes them<br>proficient.",
              "Handles": {
                "NameHandle": "hd6f09966g0c3eg5e33g80ffg961ea6a72d5d",
                "DescriptionHandle": "hd2883b92g1d73g5a1dg8389g79b19a9d3de9",
                "TooltipHandle": "hc7cc2a52g508ag5e6bg9ee6g91f9458fd2d6"
              },
              "Type": "checkbox",
              "Default": true
            },
            {
              "Id": "equipped_marks",
              "Name": "Show marks on equipped items",
              "Tooltip": "Shows a badge on equipped weapons and armor that are Bad or Not Ideal for their<br>wearer. The badge uses that rating's Badge icon and Color from the Looks tab. Good items get none.",
              "Handles": {
                "NameHandle": "had224f0ag3571g514egbdb1ga5df7cf57d64",
                "TooltipHandle": "hce14e8c1g5750g5a2cgafafgc057c591330f"
              },
              "Type": "checkbox",
              "Default": true
            },
            {
              "Id": "equipped_tooltips",
              "Name": "Explain equipped item badges on hover",
              "Tooltip": "Hovering the badge on an equipped item shows why it is Bad or Not Ideal, such as<br>Not proficient: Longswords.",
              "Handles": {
                "NameHandle": "hb6bdcd13g4cd8g5e74ga693g0663e9384a42",
                "TooltipHandle": "h7c3b61d7gbff8g5786g9891g8a1da3012d15"
              },
              "Type": "checkbox",
              "Default": true,
              "VisibleIf": {
                "Conditions": [
                  {
                    "SettingId": "equipped_marks",
                    "Operator": "==",
                    "ExpectedValue": true
                  }
                ]
              }
            },
            {
              "Id": "cell_tooltips",
              "Name": "Explain item badges on hover",
              "Tooltip": "Hovering the badge or dot on an item in an inventory, container or trade window<br>shows why it is Bad or Not Ideal, such as Not proficient: Longswords. Good items have no tooltip.",
              "Handles": {
                "NameHandle": "h0f5830c1g1ae4g52e1gb64fg5145ba74f056",
                "TooltipHandle": "he1fbe009g26bag5617g8c7dg1992c51bacdc"
              },
              "Type": "checkbox",
              "Default": true
            },
            {
              "Id": "ware_marks",
              "Name": "Show marks on Wares",
              "Tooltip": "Gives Wares the same marks as other items. Off leaves Wares unmarked.",
              "Handles": {
                "NameHandle": "hafe249a3g21a5g5c34g9241ge4ca32afe012",
                "TooltipHandle": "hee270738gcdbfg5688gb221gc452e8b79a37"
              },
              "Type": "checkbox",
              "Default": false
            },
            {
              "Id": "trade_marks",
              "Name": "Marks in Trade windows",
              "Tooltip": "How marks show on items in a Trade window, on your side and the trader's. Equipped items keep their badges.<br>Full: the same marks as everywhere else.<br>Subtle: no Dim or Gray, and the Glow, Badge and Dot at 65% strength.<br>Off: no marks.",
              "Handles": {
                "NameHandle": "h4ea89746gf80cg5baeg9dffg98cd41d531e1",
                "TooltipHandle": "h7deb0a61g8eabg528cgad64g76d53365488b",
                "ChoicesHandles": [
                  "hdcbf5b19g4a83g5a7fgafe1gf7ebade08cfe",
                  "h94f15399ge201g5f28ga752g30cebc9ed03e",
                  "h1cf02fd8gd792g5cd4ga283g0bac2c7896f0"
                ]
              },
              "Type": "enum",
              "Default": "subtle",
              "Options": {
                "Choices": [
                  "full",
                  "subtle",
                  "off"
                ]
              }
            }
          ]
        },
        {
          "SectionId": "logging",
          "SectionName": "Troubleshooting",
          "Handles": {
            "NameHandle": "h9aeadd55g7644g5764gb15bg900a4f361e1b"
          },
          "Options": {
            "IsCollapsible": true
          },
          "Settings": [
            {
              "Id": "debug_level",
              "Name": "Logging",
              "Tooltip": "Off: prints any warnings and errors to the Script Extender console, and a line<br>with your settings when a save loads.<br>Basic: also writes a log file, and prints a short line when items are rated or a<br>setting changes.<br>Verbose: also writes a sample of individual item ratings to the log file.<br><br>Log files go to<br>%LOCALAPPDATA%\\Larian Studios\\Baldur's Gate 3\\Script Extender\\ProficiencyAtAGlance. Each save you load starts a new file, and old files are kept.",
              "Handles": {
                "NameHandle": "h722a7239ga771g507cgbfbag4b68511e182e",
                "TooltipHandle": "h020e49aag6bf6g59b4g8b4dg7b848528bee4",
                "ChoicesHandles": [
                  "h1cf02fd8gd792g5cd4ga283g0bac2c7896f0",
                  "h76f25500g69e8g5deaga1ffg8eeb1580821a",
                  "hd28f0d89gf615g5ef4gb512g98b308579e33"
                ]
              },
              "Type": "enum",
              "Default": "off",
              "Options": {
                "Choices": [
                  "off",
                  "basic",
                  "verbose"
                ]
              }
            }
          ]
        }
      ]
    },
